# CIL Environment Configuration
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# The .env file is git-ignored — never commit credentials.

# ── Database ─────────────────────────────────────────────
# MongoDB connection string (required when using --mongo flag)
# Format: mongodb+srv://username:password@cluster.mongodb.net/db_name?retryWrites=true
MONGO_URI=

# Custom SQLite DB path (optional — auto-created per project if not set)
# CIL_SQLITE_DB=/path/to/cil.db

# ── LLM Enrichment ───────────────────────────────────────
# OpenAI API key for semantic enrichment (--enrich flag)
OPENAI_API_KEY=

# Custom OpenAI-compatible endpoint (e.g., local llama.cpp server)
# OPENAI_BASE_URL=http://localhost:8081/v1

# Model name for enrichment (default: gpt-4o-mini)
# CIL_LLM_MODEL=gpt-4o-mini

# ── Security (Optional) ──────────────────────────────────
# Bearer token for Flask API authentication
# CIL_API_KEY=your-secret-key

# Comma-separated allowed CORS origins for Flask API
# Default allows localhost only
# CIL_CORS_ORIGINS=http://localhost,http://127.0.0.1

# Comma-separated allowlist of directories MCP server can access
# (if unset, all accessible paths are allowed)
# CIL_ALLOWED_DIRS=/home/user/projects,/tmp

# Max file size to index in bytes (default: 5 MB = 5242880)
# CIL_MAX_FILE_SIZE=5242880
